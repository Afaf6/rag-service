# Server
PORT=5050
NODE_ENV=development

# MongoDB
DB_URL=mongodb://localhost:27017/patient_rag

# JWT - لازم يكون نفس الـ SECRET المستخدم في الباك اند الرئيسي
JWT_SECRET=secret123
JWT_EXPIRE=7d

# الباك اند الرئيسي - عشان نسحب منه المستندات وقت المزامنة (sync)
MAIN_BACKEND_URL=http://localhost:3000/api

# Gemini (مجاني - API key من https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
EMBEDDING_MODEL=gemini-embedding-001
CHAT_MODEL=gemini-2.5-flash

# Uploads
MAX_FILE_SIZE_MB=15
UPLOAD_DIR=uploads

# Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K_RESULTS=5
